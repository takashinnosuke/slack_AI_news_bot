        <link rel="enclosure" href="https://physicalainews.jp/news/jidounten-lab-cybercab-no-kojin-unyou-shuueki-shisan-wo-houd-c3ca9b/opengraph-image?239fa34c8367487c" type="image//news/jidounten-lab-cybercab-no-kojin-unyou-shuueki-shisan-wo-houd-c3ca9b/opengraph-image"/>
