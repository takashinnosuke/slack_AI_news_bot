            <link>https://physicalainews.jp/news/astraqua-nasa-kara-127-man-4990-doru-no-phase-ii-keiyaku-wo-82b15a</link>
            <guid isPermaLink="false">https://physicalainews.jp/news/astraqua-nasa-kara-127-man-4990-doru-no-phase-ii-keiyaku-wo-82b15a</guid>
